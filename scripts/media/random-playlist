#!/usr/bin/env python3
"""Generate an M3U playlist with a random sample of tracks from a directory.

Usage:
  random-playlist <source> <playlist-file> <count> [--relative] [--seed N] [--dry-run]
"""

from __future__ import annotations

import argparse
import random
import sys
from pathlib import Path

AUDIO_EXTENSIONS = frozenset(
    {
        ".aac",
        ".aiff",
        ".alac",
        ".ape",
        ".flac",
        ".m4a",
        ".mp3",
        ".ogg",
        ".opus",
        ".wav",
        ".wma",
    }
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Write an M3U of randomly chosen tracks from a source directory.",
    )
    parser.add_argument("source", type=Path, help="Directory to pick tracks from")
    parser.add_argument("playlist", type=Path, help="Output .m3u / .m3u8 path")
    parser.add_argument("count", type=int, help="Number of tracks to include")
    parser.add_argument(
        "--relative",
        action="store_true",
        help="Write paths relative to the playlist file's directory (default: absolute)",
    )
    parser.add_argument(
        "--seed",
        type=int,
        help="RNG seed for reproducible playlists",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print selected tracks without writing the playlist",
    )
    return parser.parse_args()


def collect_tracks(source: Path) -> list[Path]:
    tracks: list[Path] = []
    for path in source.rglob("*"):
        if path.is_file() and path.suffix.lower() in AUDIO_EXTENSIONS:
            tracks.append(path)
    return tracks


def format_entry(track: Path, playlist_dir: Path, relative: bool) -> str:
    resolved = track.resolve()
    if not relative:
        return resolved.as_posix()
    try:
        return resolved.relative_to(playlist_dir.resolve()).as_posix()
    except ValueError:
        # Track is outside the playlist directory — fall back to absolute
        return resolved.as_posix()


def main() -> int:
    args = parse_args()

    if args.count < 1:
        print("error: count must be at least 1", file=sys.stderr)
        return 1

    source = args.source.expanduser()
    if not source.is_dir():
        print(f"error: source is not a directory: {source}", file=sys.stderr)
        return 1

    tracks = collect_tracks(source)
    if not tracks:
        print(f"error: no audio files found under {source}", file=sys.stderr)
        return 1

    if args.seed is not None:
        random.seed(args.seed)

    take = min(args.count, len(tracks))
    if take < args.count:
        print(
            f"warning: only {len(tracks)} track(s) available; writing {take}",
            file=sys.stderr,
        )

    selected = random.sample(tracks, take)
    playlist = args.playlist.expanduser()
    playlist_dir = playlist.parent if playlist.parent.as_posix() not in ("", ".") else Path.cwd()
    entries = [format_entry(t, playlist_dir, args.relative) for t in selected]

    if args.dry_run:
        print(f"# would write {len(entries)} track(s) to {playlist}")
        for entry in entries:
            print(entry)
        return 0

    playlist_dir.mkdir(parents=True, exist_ok=True)
    body = "#EXTM3U\n" + "\n".join(entries) + "\n"
    playlist.write_text(body, encoding="utf-8")
    print(f"wrote {len(entries)} track(s) to {playlist}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
